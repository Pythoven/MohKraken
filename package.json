{
  "name": "mohkraken",
  "productName": "MohKraken",
  "version": "1.0.0",
  "description": "A GitKraken-style desktop Git client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "install-app": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir && rm -rf /Applications/MohKraken.app && ditto dist/mac/MohKraken.app /Applications/MohKraken.app && codesign --force --deep -s - /Applications/MohKraken.app",
    "dist:win": "electron-builder --win nsis"
  },
  "author": "Mohamed Saleh",
  "license": "MIT",
  "build": {
    "appId": "com.mohkraken.app",
    "productName": "MohKraken",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
